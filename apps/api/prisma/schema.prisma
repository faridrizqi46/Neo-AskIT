generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  employee
  support
  admin
}

enum RequestStatus {
  open
  in_progress
  pending
  resolved
  closed
}

enum Priority {
  low
  medium
  high
  urgent
}

enum MessageType {
  user
  assistant
  system
}

enum ActionType {
  form
  redirect
  ticket
  notification
  escalate
}

model Employee {
  id           String       @id @default(uuid()) @db.Uuid
  employeeId   String       @unique @map("employee_id") @db.VarChar(50)
  email        String       @unique @db.VarChar(255)
  name         String       @db.VarChar(255)
  department   String       @db.VarChar(100)
  role         EmployeeRole @default(employee)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  requests Request[]
  messages Message[]
  sessions Session[]

  @@map("employees")
}

model Request {
  id         String        @id @default(uuid()) @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  title      String        @db.VarChar(500)
  status     RequestStatus @default(open)
  priority   Priority      @default(medium)
  category   String        @db.VarChar(100)
  intent     String?       @map("intent") @db.VarChar(100)
  resolution String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  resolvedAt DateTime?     @map("resolved_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  messages  Message[]
  actions   Action[]

  @@map("requests")
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  requestId   String      @map("request_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  content     String      @db.Text
  messageType MessageType @map("message_type")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")

  request Request  @relation(fields: [requestId], references: [id])
  sender  Employee @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Policy {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(255)
  content   String   @db.Text
  category  String   @db.VarChar(100)
  keywords  String[] @default([])
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("policies")
}

model Action {
  id         String     @id @default(uuid()) @db.Uuid
  requestId  String     @map("request_id") @db.Uuid
  actionType ActionType @map("action_type")
  payload    Json       @default("{}")
  executedAt DateTime   @default(now()) @map("executed_at")

  request Request @relation(fields: [requestId], references: [id])

  @@map("actions")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  context    Json     @default("{}")
  lastIntent String?  @map("last_intent") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  expiresAt  DateTime @map("expires_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("sessions")
}